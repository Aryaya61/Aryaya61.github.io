fa:{nav1:"توانمندی‌ها",nav2:"حوزه‌ها",nav3:"قراردادها",nav4:"مدیریت",nav5:"ارتباط با ما",eyebrow:"سرمایه‌گذاری راهبردی • تأمین مالی ساختاریافته",heroTitle:"سرمایه‌ای برای به حرکت درآوردن<br>پروژه‌های بزرگ و آینده‌ساز.",heroText:"ما میان پروژه‌های دارای ظرفیت اقتصادی و منابع سرمایه ارتباط برقرار می‌کنیم، ساختار معاملات پیچیده را طراحی می‌کنیم و به سرمایه‌گذاران و صاحبان پروژه کمک می‌کنیم تا فرصت‌ها را با شفافیت، انضباط و هماهنگی حرفه‌ای به مرحله اجرا نزدیک کنند.",cta:"درباره پروژه گفت‌وگو کنیم ↗",explore:"آشنایی با توانمندی‌ها",capEyebrow:"خدمات ما",capTitle:"از راهبرد سرمایه تا<br>اجرای معامله.",capLead:"فعالیت ما تلفیقی از ساختاردهی مالی، شناخت تجاری و هماهنگی ذی‌نفعان است. مسیر تأمین مالی را متناسب با مرحله پروژه، ریسک‌ها، دارایی‌ها و اهداف راهبردی آن طراحی می‌کنیم.",c1t:"تأمین مالی پروژه",c1p:"طراحی راهبرد تأمین مالی و ساختار مالی برای طرح‌های سرمایه‌بر؛ از بررسی امکان‌سنجی و بانک‌پذیری تا مذاکره با تأمین‌کنندگان سرمایه و آماده‌سازی برای نهایی‌شدن تأمین مالی.",c2t:"تأمین مالی تجارت و اعتبار اسنادی",c2p:"پشتیبانی در ساختاردهی اعتبار اسنادی، ابزارهای تجاری، پرداخت به تأمین‌کنندگان و معاملات فرامرزی؛ با رعایت الزامات بانک‌ها و مقررات مربوط.",c3t:"تأمین مالی مبتنی بر دارایی",c3p:"بررسی امکان تأمین مالی بر پایه دارایی‌های واجد شرایط، مطالبات یا تجهیزات، با توجه به ارزش‌گذاری، کیفیت وثایق، تعهدات قراردادی و توان بازپرداخت.",sectorEyebrow:"حوزه‌های فعالیت",sectorTitle:"تأمین سرمایه برای<br>دارایی‌های حیاتی اقتصاد.",sectorLead:"در بخش‌هایی فعالیت می‌کنیم که مقیاس بزرگ، دوره توسعه طولانی و تعدد ذی‌نفعان، تأمین مالی را پیچیده‌تر می‌کند و به ساختاردهی دقیق نیاز دارد.",s1t:"انرژی، نفت و گاز",s1p:"پروژه‌های بالادستی، میان‌دستی، پایین‌دستی و نیروگاهی؛ برنامه‌ریزی سرمایه، مسیرهای تأمین مالی پروژه، تأمین مالی تجهیزات و زیرساخت و هماهنگی میان صاحبان طرح، بهره‌برداران، تأمین‌کنندگان و سرمایه‌گذاران.",s2t:"املاک و مسکن",s2p:"پروژه‌های مسکونی، تجاری و چندمنظوره؛ تأمین مالی توسعه، برنامه سرمایه‌گذاری مرحله‌ای، ساختارهای مبتنی بر دارایی و طراحی منابع متناسب با نقاط عطف و جریان نقدی پروژه.",s3t:"بیمارستان و مراکز درمانی",s3p:"ساخت و توسعه بیمارستان و تأمین تجهیزات پزشکی؛ برنامه‌های مالی با توجه به زمان‌بندی خرید، آمادگی بهره‌برداری، تقاضای بلندمدت و پایداری اقتصادی خدمات ضروری.",approachEyebrow:"رویکرد ما",approachTitle:"ساختار شفاف؛<br>منافع هم‌راستا.",approachText:"هر فرصت تأمین مالی با شناخت دقیق پروژه آغاز می‌شود: توان حامی طرح، مدل تجاری، دارایی‌ها، مجوزها، طرف‌های معامله، جریان‌های نقدی پیش‌بینی‌شده و شکاف مالی. ما به سامان‌دهی این عناصر در قالب یک پرونده منسجم، شناسایی مسیرهای مناسب تأمین مالی، آماده‌سازی مستندات برای بررسی و هماهنگی گفت‌وگو میان صاحبان پروژه، سرمایه‌گذاران، بانک‌ها، بیمه‌گران و مشاوران تخصصی کمک می‌کنیم. هدف ما قابل‌ارزیابی و اجرایی‌تر کردن فرصت‌های پیچیده است، نه تضمین نتیجه تأمین مالی. همه معاملات منوط به بررسی موشکافانه، احراز شرایط، رعایت مقررات و تأیید نهایی طرف‌های مربوط است.",quote:"«پروژه‌ای قابل تأمین مالی است که اطلاعات معتبر، تقسیم متوازن ریسک و تعهدات روشن داشته باشد.»",contractEyebrow:"قراردادها و ساختاردهی معاملات",contractTitle:"چارچوبی برای<br>معاملات قابل اتکا.",contractLead:"در طراحی چارچوب تجاری و قراردادی کمک می‌کنیم تا سرمایه‌گذار و صاحب پروژه حقوق، مسئولیت‌ها، شروط و میزان ریسک خود را روشن و قابل بررسی ببینند.",ct1:"ترم‌شیت و قرارداد مأموریت تأمین مالی",cp1:"تعیین دامنه خدمات، ساختار پیشنهادی، کارمزدها، زمان‌بندی، انحصار در صورت توافق، شروط مقدماتی و مسئولیت هر طرف پیش از تهیه اسناد تفصیلی.",ct2:"اسناد تسهیلات و قراردادهای وام",cp2:"هماهنگی بررسی شرایط تسهیلات، شروط برداشت، برنامه بازپرداخت، وثایق، اظهارات و تضمین‌ها، تعهدات مالی، موارد نقض قرارداد و الزامات ارائه اطلاعات با مشاوران حقوقی و مالی واجد صلاحیت.",ct3:"ابزارهای تجاری و قراردادهای خرید",cp3:"هم‌راستا کردن قراردادهای تجاری، شرایط تحویل و بازرسی، محرک‌های پرداخت، مدارک لازم و ابزارهای تأمین مالی تجارت مانند اعتبار اسنادی.",ct4:"قراردادهای مشارکت، EPC و پروژه",cp4:"هماهنگی درباره اصول مشارکت، نقاط عطف مهندسی و ساخت، تعهدات عملکردی، تغییرات، ضمانت‌ها و نحوه تخصیص ریسک‌های پروژه.",bandTitle:"پروژه‌ای برای تأمین مالی دارید یا سرمایه‌ای برای تخصیص؟",bandCta:"گفت‌وگو را آغاز کنیم ↗",leaderEyebrow:"مدیریت",leaderFa:"سید حسن حسینی",leaderText:"سید حسن حسینی هدایت راهبرد گروه و توسعه روابط تجاری را بر عهده دارد و میان صاحبان پروژه، شرکای سرمایه‌ای و مشاوران تخصصی ارتباط برقرار می‌کند. تمرکز او بر ارزیابی منضبط فرصت‌ها، ساختارهای عملی تأمین مالی و ایجاد روابط تجاری بلندمدت در حوزه‌های انرژی، املاک، سلامت و تجارت است.",contactEyebrow:"در ارتباط باشیم",contactTitle:"از پروژه‌ای که می‌سازید بگویید.",contactText:"چند نکته درباره پروژه، نیاز مالی یا مأموریت سرمایه‌گذاری خود بنویسید تا بتوانیم فرصت را بهتر بشناسیم و مسیر گفت‌وگوی بعدی را مشخص کنیم.",contactNote:"رعایت محرمانگی و بررسی شرایط لازم است.",select:"حوزه مورد نظر",send:"ارسال درخواست ↗",foot:"تأمین مالی راهبردی • مشاوره پروژه • پشتیبانی معاملات",name:"نام و نام خانوادگی",email:"ایمیل کاری",company:"شرکت / سازمان",message:"پروژه یا نیاز خود را کوتاه توضیح دهید"},
ar:{nav1:"قدراتنا",nav2:"القطاعات",nav3:"المعاملات",nav4:"القيادة",nav5:"اتصل بنا",eyebrow:"رأس المال الاستراتيجي • التمويل المنظم",heroTitle:"رأس مال يدفع<br>المشاريع الطموحة إلى الأمام.",heroText:"نربط المشاريع القابلة للتنفيذ بمصادر رأس المال، ونهيكل المعاملات المعقدة، ونساعد المستثمرين وأصحاب المشاريع على الانتقال من الفرصة إلى التنفيذ بوضوح وانضباط وتنسيق موثوق.",cta:"ناقش مشروعاً ↗",explore:"اكتشف قدراتنا",capEyebrow:"ماذا نقدم",capTitle:"من استراتيجية رأس المال<br>إلى إنجاز المعاملة.",capLead:"نجمع بين الهيكلة المالية والرؤية التجارية وتنسيق أصحاب المصلحة، ونصمم مسارات التمويل وفق مرحلة المشروع ومخاطره وأصوله وأهدافه.",c1t:"تمويل المشاريع",c1p:"استراتيجية التمويل والهيكلة المالية للمشاريع كثيفة رأس المال، من دراسة الجدوى والجدارة التمويلية إلى التواصل مع الممولين والإقفال المالي.",c2t:"تمويل التجارة والاعتمادات",c2p:"دعم الاعتمادات المستندية وأدوات التجارة وهياكل سداد الموردين والمعاملات العابرة للحدود، وفق موافقات البنوك ومتطلبات الامتثال.",c3t:"التمويل القائم على الأصول",c3p:"بحث التمويل بضمان الأصول المؤهلة أو المستحقات أو المعدات، مع مراعاة التقييم وجودة الضمانات والتعهدات والقدرة على السداد.",sectorEyebrow:"القطاعات",sectorTitle:"رأس مال للأصول<br>الأساسية في الاقتصاد.",sectorLead:"نعمل في قطاعات تجعل فيها أحجام المشاريع وطول دورات التطوير وتعدد الأطراف التمويل أكثر تعقيداً، مما يتطلب هيكلة دقيقة.",s1t:"الطاقة والنفط والغاز",s1p:"مشاريع المنبع والوسط والمصب والطاقة: تخطيط رأس المال، مسارات تمويل المشاريع، تمويل المعدات والبنية التحتية، والتنسيق بين المطورين والمشغلين والموردين والممولين.",s2t:"العقارات والإسكان",s2p:"المشاريع السكنية والتجارية ومتعددة الاستخدامات: تمويل التطوير، خطط رأس المال المرحلية، الهياكل المدعومة بالأصول وربط التمويل بمراحل الإنجاز والتدفقات النقدية.",s3t:"المستشفيات والمنشآت الطبية",s3p:"إنشاء المستشفيات وتوسعتها والمعدات الطبية: خطط تمويل تراعي المشتريات والاستعداد التشغيلي والطلب طويل الأجل والاستدامة المالية للخدمات الأساسية.",approachEyebrow:"نهجنا",approachTitle:"هياكل واضحة.<br>مصالح متوافقة.",approachText:"تبدأ كل فرصة تمويل بفهم منضبط للمشروع: قوة الراعي، النموذج التجاري، الأصول، التصاريح، الأطراف المقابلة، التدفقات النقدية المتوقعة والفجوة التمويلية. نساعد في تنظيم هذه العناصر ضمن ملف متكامل، وتحديد مسارات التمويل المناسبة، وإعداد المواد للمراجعة وتنسيق الحوار بين أصحاب المشاريع والمستثمرين والبنوك وشركات التأمين والمستشارين. دورنا تسهيل تقييم الفرص المعقدة وتنفيذها، لا ضمان نتائج التمويل. وتظل جميع المعاملات خاضعة للعناية الواجبة والأهلية والامتثال والموافقة النهائية للأطراف المعنية.",quote:"«المشروع القابل للتمويل يقوم على معلومات موثوقة وتوزيع متوازن للمخاطر والتزامات محددة بوضوح.»",contractEyebrow:"العقود وهيكلة المعاملات",contractTitle:"الإطار الذي يدعم<br>المعاملات الموثوقة.",contractLead:"ندعم البنية التجارية والتعاقدية التي توضح لمقدمي رأس المال ورعاة المشاريع حقوقهم ومسؤولياتهم وشروطهم ومخاطرهم.",ct1:"خطابات الشروط وتفويضات التمويل",cp1:"توضيح نطاق العمل والهيكل المقترح والرسوم والمراحل والحصرية عند الاتفاق والشروط السابقة ومسؤوليات كل طرف قبل إعداد الوثائق التفصيلية.",ct2:"وثائق القروض والتسهيلات",cp2:"تنسيق مراجعة شروط التسهيلات والسحب والسداد والضمانات والتعهدات وحالات الإخلال ومتطلبات المعلومات مع مستشارين قانونيين وماليين مؤهلين.",ct3:"أدوات التجارة وعقود الشراء",cp3:"مواءمة العقود التجارية وشروط التسليم والفحص ومحفزات الدفع والمستندات المطلوبة وأدوات تمويل التجارة مثل الاعتمادات المستندية.",ct4:"اتفاقيات المشاريع والمشاركة وEPC",cp4:"دعم التنسيق بشأن مبادئ الشراكة ومراحل الهندسة والإنشاء والتزامات الأداء وإجراءات التغيير والضمانات وتوزيع مخاطر المشروع.",bandTitle:"هل لديك مشروع يحتاج إلى تمويل أو رأس مال للاستثمار؟",bandCta:"ابدأ الحوار ↗",leaderEyebrow:"القيادة",leaderFa:"سید حسن حسینی",leaderText:"يقود حسن حسيني التوجه الاستراتيجي للمجموعة وتطوير العلاقات، ويربط أصحاب المشاريع بشركاء رأس المال والمستشارين المتخصصين. يركز عمله على تقييم الفرص بانضباط، وهياكل تمويل عملية، وعلاقات تجارية طويلة الأمد في الطاقة والعقارات والرعاية الصحية والتجارة.",contactEyebrow:"لنتواصل",contactTitle:"أخبرنا عما تعمل على إنجازه.",contactText:"شاركنا بعض التفاصيل عن مشروعك أو احتياجك التمويلي أو تفويضك الاستثماري، لنفهم الفرصة ونحدد الخطوة التالية المناسبة.",contactNote:"تخضع الطلبات للسرية ومراجعة الأهلية.",select:"مجال الاهتمام",send:"إرسال الطلب ↗",foot:"تمويل استراتيجي • استشارات المشاريع • دعم المعاملات",name:"الاسم الكامل",email:"البريد الإلكتروني للعمل",company:"الشركة / المؤسسة",message:"صف مشروعك أو احتياجك بإيجاز"}
};
function setLang(lang){let d=copy[lang];document.documentElement.lang=lang;document.body.lang=lang;document.body.dir=lang==='en'?'ltr':'rtl';document.querySelectorAll('[data-i]').forEach(el=>{let k=el.dataset.i;if(d[k])el.innerHTML=d[k]});document.querySelectorAll('[data-ph]').forEach(el=>el.placeholder=d[el.dataset.ph]);document.querySelectorAll('option').forEach(el=>{if(el.dataset.i==='select')el.textContent=d.select});document.getElementById('language').value=lang}
document.getElementById('language').addEventListener('change',e=>setLang(e.target.value));document.getElementById('year').textContent=new Date().getFullYear();
const obs=new IntersectionObserver(entries=>entries.forEach(e=>{if(e.isIntersecting){e.target.classList.add('show');obs.unobserve(e.target)}}),{threshold:.12});document.querySelectorAll('.reveal').forEach(el=>obs.observe(el));
</script></body></html>
